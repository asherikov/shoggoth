{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "CPU Usage",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max by(service) (rate(container_cpu_time_seconds_total{service=\"$service\"}[5m]))", "legendFormat": "CPU cores", "refId": "A"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "min": 0,
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Memory Usage",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max by(service) (container_memory_usage_bytes{service=\"$service\"})", "legendFormat": "Memory usage", "refId": "A"},
                {"expr": "max by(service) (container_spec_memory_limit_bytes{service=\"$service\"})", "legendFormat": "Limit", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Network I/O",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum by(service) (rate(k8s_pod_network_io_bytes_total{service=\"$service\",direction=\"receive\"}[5m]))", "legendFormat": "↓ Receive", "refId": "A"},
                {"expr": "sum by(service) (rate(k8s_pod_network_io_bytes_total{service=\"$service\",direction=\"transmit\"}[5m]))", "legendFormat": "↑ Transmit", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Working Set",
            "type": "stat",
            "gridPos": {"h": 4, "w": 12, "x": 0, "y": 16},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max(container_memory_working_set_bytes{service=\"$service\"})", "legendFormat": "", "refId": "A"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "color": {"mode": "value"}
                },
                "overrides": []
            }
        },
        {
            "title": "Uptime",
            "type": "stat",
            "gridPos": {"h": 4, "w": 12, "x": 12, "y": 16},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max by(service) (container_uptime_seconds_total{service=\"$service\"})", "legendFormat": "", "refId": "A"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
                    "color": {"mode": "thresholds"}
                },
                "overrides": []
            }
        },
        {
            "title": "Service Logs",
            "type": "logs",
            "gridPos": {"h": 12, "w": 24, "x": 0, "y": 20},
            "datasource": {"uid": "loki"},
            "targets": [
                {"expr": "{service=\"$service\"}", "refId": "A"}
            ],
            "options": {"showLabels": false, "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "wrapLogMessage": true, "prettifyLogMessage": true}
        }
    ],
    "refresh": "30s",
    "schemaVersion": 40,
    "tags": ["shoggoth", "service"],
    "templating": {
        "list": [
            {
                "current": {"text": "", "value": ""},
                "definition": "label_values(container_cpu_time_seconds_total{service=~\".+\"}, service)",
                "hide": 0,
                "includeAll": false,
                "label": "Service",
                "multi": false,
                "name": "service",
                "options": [],
                "query": {"qryType": 1, "query": "label_values(container_cpu_time_seconds_total{service=~\".+\"}, service)", "refId": "VariableQuery-0"},
                "refresh": 2,
                "sort": 1,
                "type": "query",
                "datasource": {"uid": "vm"}
            }
        ]
    },
    "time": {"from": "now-1h", "to": "now"},
    "title": "Shoggoth Service",
    "description": "Per-service observability: CPU, memory, network, disk, and logs for a single selected container",
    "uid": "shoggoth-service",
    "version": 3
}