{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "CPU Usage",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max by(compose_service) (rate(container_cpu_usage_nanoseconds_total{compose_service=\"$service\"}[5m])) / 1e9", "legendFormat": "CPU cores", "refId": "A"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "min": 0,
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Memory Usage",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max by(compose_service) (container_memory_usage_total_bytes{compose_service=\"$service\"})", "legendFormat": "Working set", "refId": "A"},
                {"expr": "max by(compose_service) (container_memory_usage_limit_bytes{compose_service=\"$service\"})", "legendFormat": "Limit", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Network I/O",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum by(compose_service) (rate(container_network_io_usage_rx_bytes_total{compose_service=\"$service\"}[5m]))", "legendFormat": "↓ Receive", "refId": "A"},
                {"expr": "sum by(compose_service) (rate(container_network_io_usage_tx_bytes_total{compose_service=\"$service\"}[5m]))", "legendFormat": "↑ Transmit", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Restart Count",
            "type": "stat",
            "gridPos": {"h": 4, "w": 12, "x": 0, "y": 16},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max(container_restarts_total{compose_service=\"$service\"}) or on() vector(0)", "legendFormat": "", "refId": "A"}
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
                    "color": {"mode": "thresholds"}
                },
                "overrides": []
            }
        },
        {
            "title": "Uptime",
            "type": "stat",
            "gridPos": {"h": 4, "w": 12, "x": 12, "y": 16},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "max by(compose_service) (container_uptime_seconds{compose_service=\"$service\"})", "legendFormat": "", "refId": "A"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
                    "color": {"mode": "thresholds"}
                },
                "overrides": []
            }
        },
        {
            "title": "Service Logs",
            "type": "logs",
            "gridPos": {"h": 12, "w": 24, "x": 0, "y": 20},
            "datasource": {"uid": "loki"},
            "targets": [
                {"expr": "{compose_service=\"$service\"}", "refId": "A"}
            ],
            "options": {"showLabels": false, "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "wrapLogMessage": true, "prettifyLogMessage": true}
        }
    ],
    "refresh": "30s",
    "schemaVersion": 40,
    "tags": ["shoggoth", "service"],
    "templating": {
        "list": [
            {
                "current": {"text": "", "value": ""},
                "definition": "label_values(container_cpu_usage_nanoseconds_total{compose_service=~\".+\"}, compose_service)",
                "hide": 0,
                "includeAll": false,
                "label": "Service",
                "multi": false,
                "name": "service",
                "options": [],
                "query": {"qryType": 1, "query": "label_values(container_cpu_usage_nanoseconds_total{compose_service=~\".+\"}, compose_service)", "refId": "VariableQuery-0"},
                "refresh": 2,
                "sort": 1,
                "type": "query",
                "datasource": {"uid": "vm"}
            }
        ]
    },
    "time": {"from": "now-1h", "to": "now"},
    "title": "Shoggoth Service",
    "description": "Per-service observability: CPU, memory, network, disk, and logs for a single selected container",
    "uid": "shoggoth-service",
    "version": 2
}