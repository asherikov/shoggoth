{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "LLM Request Rate",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "uid": "vm"
            },
            "targets": [
                {
                    "expr": "sum(rate(litellm_request_total_latency_metric_count[5m])) by (requested_model)",
                    "legendFormat": "{{requested_model}}",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(litellm_deployment_failure_responses_total[5m])) by (requested_model)",
                    "legendFormat": "{{requested_model}} errors",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 1.5,
                        "showPoints": "never",
                        "fillOpacity": 10
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*errors"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "title": "LLM Request Latency",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 8,
                "y": 0
            },
            "datasource": {
                "uid": "vm"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.5, sum(rate(litellm_request_total_latency_metric_bucket[5m])) by (le, requested_model))",
                    "legendFormat": "p50 {{requested_model}}",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(litellm_request_total_latency_metric_bucket[5m])) by (le, requested_model))",
                    "legendFormat": "p95 {{requested_model}}",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(litellm_request_total_latency_metric_bucket[5m])) by (le, requested_model))",
                    "legendFormat": "p99 {{requested_model}}",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 1.5,
                        "showPoints": "never",
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            }
        },
