        {
            "title": "LiteLLM Trace Rate",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 0,
                "y": 18
            },
            "datasource": {
                "uid": "vm"
            },
            "targets": [
                {
                    "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"litellm\"}[5m])) by (span_name)",
                    "legendFormat": "{{span_name}}",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"litellm\", status_code=\"ERROR\"}[5m])) by (span_name)",
                    "legendFormat": "{{span_name}} errors",
                    "refId": "B"
                }
            ],
            "description": "All LiteLLM spans by operation. LLM proxy and MCP gateway calls share the same span names and cannot be separated in span-metrics; use AI Traces below to inspect individual requests.",
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 1.5,
                        "showPoints": "never",
                        "fillOpacity": 10
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*errors"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            }
        },
