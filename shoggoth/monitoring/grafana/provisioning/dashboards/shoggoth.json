{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "Host CPU Utilization",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 6, "x": 0, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [{"expr": "100 - (avg by(host_name)(rate(system_cpu_time_seconds_total{state=\"idle\"}[5m])) * 100)", "legendFormat": "{{host_name}}", "refId": "A"}],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Host Memory Usage",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 6, "x": 6, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [{"expr": "(1 - system_linux_memory_available_bytes / system_memory_limit_bytes) * 100", "legendFormat": "{{host_name}}", "refId": "A"}],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Host Disk Usage",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 6, "x": 12, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [{"expr": "system_filesystem_utilization_ratio{type!~\"tmpfs|squashfs|overlay\"} * 100", "legendFormat": "{{mountpoint}}", "refId": "A"}],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Network Throughput",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 6, "x": 18, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "rate(system_network_io_bytes_total{direction=\"receive\",device=~\"eth.*|wlan.*|enp.*\"}[5m])", "legendFormat": "↓ {{device}}", "refId": "A"},
                {"expr": "rate(system_network_io_bytes_total{direction=\"transmit\",device=~\"eth.*|wlan.*|enp.*\"}[5m])", "legendFormat": "↑ {{device}}", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Load Average (1m / 5m / 15m)",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 0, "y": 10},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "system_cpu_load_average_1m", "legendFormat": "load 1m", "refId": "A"},
                {"expr": "system_cpu_load_average_5m", "legendFormat": "load 5m", "refId": "B"},
                {"expr": "system_cpu_load_average_15m", "legendFormat": "load 15m", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Process Count by Status",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 12, "y": 10},
            "datasource": {"uid": "vm"},
            "targets": [{"expr": "system_processes_count", "legendFormat": "{{host_name}} {{status}}", "refId": "A"}],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Container CPU Usage",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 0, "y": 19},
            "datasource": {"uid": "vm"},
            "targets": [{"expr": "max by(compose_service) (rate(container_cpu_usage_nanoseconds_total{compose_service=~\".+\"}[5m])) / 1e9", "legendFormat": "{{compose_service}}", "refId": "A"}],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "min": 0,
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Container Memory Usage",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 12, "y": 19},
            "datasource": {"uid": "vm"},
            "targets": [{"expr": "max by(compose_service) (container_memory_usage_total_bytes{compose_service=~\".+\"})", "legendFormat": "{{compose_service}}", "refId": "A"}],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Container Log Rate",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 24, "x": 0, "y": 28},
            "datasource": {"uid": "loki"},
            "targets": [{"expr": "sum by (compose_service) (rate({compose_service=~\".+\"}[5m]))", "legendFormat": "{{compose_service}}", "refId": "A"}],
            "fieldConfig": {
                "defaults": {
                    "unit": "lops",
                    "min": 0,
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Error Logs",
            "type": "logs",
            "gridPos": {"h": 18, "w": 24, "x": 0, "y": 37},
            "datasource": {"uid": "loki"},
            "targets": [
                {"expr": "{compose_service=~\".+\"} |~ \"(?i)(error|fatal|panic|critical|fail|FATAL|CRIT)|ERR\" !~ \"(?i)trace\" | line_format \"{{.compose_service}} {{__line__}}\"", "refId": "A"}
            ],
            "options": {"showLabels": false, "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "wrapLogMessage": true, "prettifyLogMessage": true}
        },
        {
            "title": "Trace Rate",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 0, "y": 56},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(rate(traces_spanmetrics_calls_total[5m]))", "legendFormat": "traces/s", "refId": "A"},
                {"expr": "sum(rate(traces_spanmetrics_calls_total{status_code=\"ERROR\"}[5m]))", "legendFormat": "errors/s", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "errors/s"},
                        "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
                    }
                ]
            }
        },
        {
            "title": "Trace Duration (p50 / p95 / p99)",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 12, "y": 56},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "histogram_quantile(0.5, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
                {"expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
                {"expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Traces",
            "type": "table",
            "gridPos": {"h": 12, "w": 24, "x": 0, "y": 66},
            "datasource": {"type": "tempo", "uid": "tempo"},
            "targets": [
                {"refId": "A", "datasource": {"type": "tempo", "uid": "tempo"}, "query": "{}", "queryType": "traceql", "tableType": "traces", "limit": 20}
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {"cellOptions": {"type": "auto"}}
                },
                "overrides": []
            },
            "options": {"showHeader": true}
        }
    ],
    "refresh": "30s",
    "schemaVersion": 40,
    "tags": ["shoggoth"],
    "templating": {
        "list": []
    },
    "time": {"from": "now-1h", "to": "now"},
    "title": "Shoggoth",
    "description": "Shoggoth infrastructure overview: host metrics and traces",
    "uid": "shoggoth",
    "version": 1
}