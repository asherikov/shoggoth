                {"expr": "sum(rate(kestra_indexer_message_out_count_total[5m]))", "legendFormat": "messages out/s", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Indexer Duration (p50 / p99)",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 8, "y": 18},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "histogram_quantile(0.5, sum(rate(kestra_indexer_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
                {"expr": "histogram_quantile(0.99, sum(rate(kestra_indexer_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Queue Rate",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 16, "y": 18},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(rate(kestra_queue_message_emitted_total_total[5m]))", "legendFormat": "emitted/s", "refId": "A"},
                {"expr": "sum(rate(kestra_queue_message_big_total_total[5m]))", "legendFormat": "big messages/s", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byRegexp", "options": ".*big messages.*"},
                        "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
                    }
                ]
            }
        },
        {
            "title": "Scheduler Activity",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 0, "y": 27},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(rate(kestra_scheduler_trigger_count_total[5m]))", "legendFormat": "triggers/s", "refId": "A"},
                {"expr": "sum(kestra_worker_trigger_running_count)", "legendFormat": "triggers running", "refId": "B"},
                {"expr": "sum(rate(kestra_executor_taskrun_created_count_total[5m]))", "legendFormat": "taskruns created/s", "refId": "C"}
