        },
        {
            "title": "Executor Task Results",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 16, "y": 27},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(rate(kestra_executor_taskrun_ended_count_total[5m]))", "legendFormat": "taskrun ended/s", "refId": "A"},
