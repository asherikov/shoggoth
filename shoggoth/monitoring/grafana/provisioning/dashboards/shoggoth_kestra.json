            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "triggers running"},
                        "properties": [{"id": "custom.drawStyle", "value": "bars"}]
                    }
                ]
            }
        },
        {
            "title": "Queue Consume Duration (p50 / p99)",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 8, "y": 27},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "histogram_quantile(0.5, sum(rate(kestra_queue_consume_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
                {"expr": "histogram_quantile(0.99, sum(rate(kestra_queue_consume_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "B"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
