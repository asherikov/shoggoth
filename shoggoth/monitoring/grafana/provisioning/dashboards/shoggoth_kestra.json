{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "Execution Rate",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 0, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(rate(kestra_executor_execution_started_count_total[5m]))", "legendFormat": "started/s", "refId": "A"},
                {"expr": "sum(rate(kestra_executor_execution_end_count_total[5m]))", "legendFormat": "ended/s", "refId": "B"},
                {"expr": "sum(rate(kestra_executor_execution_queued_count_total[5m]))", "legendFormat": "queued/s", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Task Run Rate",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 8, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(rate(kestra_worker_started_count_total[5m]))", "legendFormat": "started/s", "refId": "A"},
                {"expr": "sum(rate(kestra_worker_ended_count_total[5m]))", "legendFormat": "ended/s", "refId": "B"},
                {"expr": "sum(rate(kestra_worker_timeout_count_total[5m]))", "legendFormat": "timed out/s", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byRegexp", "options": ".*timed out.*"},
                        "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
                    }
                ]
            }
        },
        {
            "title": "Running Tasks",
            "type": "stat",
            "gridPos": {"h": 9, "w": 4, "x": 16, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(kestra_worker_running_count)", "legendFormat": "running", "refId": "A"},
                {"expr": "sum(kestra_controller_job_inflight)", "legendFormat": "inflight", "refId": "B"},
                {"expr": "sum(kestra_worker_pending_count)", "legendFormat": "pending", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}]},
                    "color": {"mode": "thresholds"}
                },
                "overrides": []
            }
        },
        {
            "title": "Worker Threads",
            "type": "stat",
            "gridPos": {"h": 9, "w": 4, "x": 20, "y": 0},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(kestra_worker_job_thread)", "legendFormat": "threads", "refId": "A"}
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
                    "color": {"mode": "thresholds"}
                },
                "overrides": []
            }
        },
        {
            "title": "Execution Duration (p50 / p95 / p99)",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "histogram_quantile(0.5, sum(rate(kestra_executor_execution_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
                {"expr": "histogram_quantile(0.95, sum(rate(kestra_executor_execution_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
                {"expr": "histogram_quantile(0.99, sum(rate(kestra_executor_execution_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Task Duration (p50 / p95 / p99)",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "histogram_quantile(0.5, sum(rate(kestra_worker_ended_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
                {"expr": "histogram_quantile(0.95, sum(rate(kestra_worker_ended_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
                {"expr": "histogram_quantile(0.99, sum(rate(kestra_worker_ended_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1.5, "showPoints": "never", "fillOpacity": 10}
                },
                "overrides": []
            }
        },
        {
            "title": "Indexer Rate",
            "type": "timeseries",
            "gridPos": {"h": 9, "w": 8, "x": 0, "y": 18},
            "datasource": {"uid": "vm"},
            "targets": [
                {"expr": "sum(rate(kestra_indexer_request_count_total[5m]))", "legendFormat": "requests/s", "refId": "A"},
