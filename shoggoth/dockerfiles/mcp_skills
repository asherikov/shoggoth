FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    MCP_SKILLS_PORT=80 \
    PIP_INDEX_URL=http://proxpi.shoggoth.local/index/ \
    PIP_TRUSTED_HOST=proxpi.shoggoth.local

WORKDIR /app

COPY private/apt-cache.conf /etc/apt/apt.conf.d/00-shoggoth-apt-cache

RUN \
--mount=type=cache,target=/var/cache/apt,sharing=locked \
--mount=type=cache,target=/var/lib/apt/lists/,sharing=locked \
    apt update \
    && apt install -y --no-install-recommends curl

RUN \
--mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-cache-dir "fastmcp>=3.0.0"

RUN cat > server.py << 'EOF'
import os

from pathlib import Path

from fastmcp import FastMCP
from fastmcp.server.providers.skills import SkillsDirectoryProvider

SKILLS_DIR = Path("/app/skills")

mcp = FastMCP("Skills Server")
mcp.add_provider(SkillsDirectoryProvider(roots=SKILLS_DIR, reload=True))

if __name__ == "__main__":
    mcp.run(transport="http", host="0.0.0.0", port=int(os.environ.get("MCP_SKILLS_PORT", 8000)))
EOF

CMD ["python", "server.py"]