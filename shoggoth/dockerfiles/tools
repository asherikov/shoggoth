ARG BASE_IMAGE=alpine:3.22
FROM ${BASE_IMAGE}

ARG PYTHON_PKG="ldap3"
RUN apk add --no-cache \
        bash \
        ca-certificates \
        coreutils \
        curl \
        gettext \
        git \
        jq \
        kubectl \
        openldap-clients \
        openssl \
        openssh-client \
        python3 \
        py3-pip \
    && pip install --no-cache-dir --break-system-packages ${PYTHON_PKG}
