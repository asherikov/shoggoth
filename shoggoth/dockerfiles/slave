ARG BASE_IMAGE=asherikov/ccws_qwen_noble:latest
FROM ${BASE_IMAGE}

ARG SHOGGOTH_SKILL_DIR=/ccws/skills/
ENV SHOGGOTH_SKILL_DIR=${SHOGGOTH_SKILL_DIR}

USER root

RUN \
--mount=type=cache,target=/var/cache/apt,sharing=locked \
--mount=type=cache,target=/var/lib/apt/lists/,sharing=locked \
--mount=type=cache,target=/cache/pip,sharing=locked \
    curl -fsSL http://download.docker.com/linux/ubuntu/gpg -o /etc/apt/trusted.gpg.d/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture)] http://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
        | sudo tee /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && ${APT_INSTALL} \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
        ttyd \
    && usermod -aG docker ccws

# nodejs is needed for some actions, e.g., actions/checkout@v5
# ldap-utils is needed for LDAP provisioning; slapd provides slappasswd for hash generation
RUN \
--mount=type=cache,target=/var/cache/apt,sharing=locked \
--mount=type=cache,target=/var/lib/apt/lists/,sharing=locked \
--mount=type=cache,target=/cache/pip,sharing=locked \
    ${APT_INSTALL} nodejs ldap-utils slapd

RUN curl -fsSL https://dl.gitea.io/tea/main/tea-main-linux-`dpkg --print-architecture` -o /usr/bin/tea \
    && chmod +x /usr/bin/tea

RUN curl -fsSL \
        "https://github.com/aarondpn/redmine-cli/releases/latest/download/redmine-cli-linux-`dpkg --print-architecture`.tar.gz" \
    | tar -xz -C /usr/bin

USER ccws

# create qwen directory with correct permissions to facilitate mounting files inside
RUN \
    mkdir -p /home/ccws/.qwen/

RUN \
--mount=type=cache,target=/cache/pip,sharing=locked \
    pip install mcp opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp-proto-http

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/gitea-tea \
    && curl -fsSL \
        https://raw.githubusercontent.com/beshkenadze/claude-skills-marketplace/main/skills/development/gitea-tea/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/gitea-tea/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/redmine-cli \
    && curl -fsSL https://raw.githubusercontent.com/aarondpn/redmine-cli/main/skills/redmine-cli/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/redmine-cli/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/kestra-flow \
    && curl -fsSL https://raw.githubusercontent.com/kestra-io/agent-skills/main/skills/kestra-flow/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/kestra-flow/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/memory-notes \
    && curl -fsSL https://raw.githubusercontent.com/basicmachines-co/basic-memory-skills/refs/heads/main/memory-notes/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/memory-notes/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/memory-reflect \
    && curl -fsSL https://raw.githubusercontent.com/basicmachines-co/basic-memory-skills/refs/heads/main/memory-reflect/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/memory-reflect/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/memory-schema \
    && curl -fsSL https://raw.githubusercontent.com/basicmachines-co/basic-memory-skills/refs/heads/main/memory-schema/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/memory-schema/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/memory-defrag \
    && curl -fsSL https://raw.githubusercontent.com/basicmachines-co/basic-memory-skills/refs/heads/main/memory-defrag/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/memory-defrag/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/memory-lifecycle \
    && curl -fsSL https://raw.githubusercontent.com/basicmachines-co/basic-memory-skills/refs/heads/main/memory-lifecycle/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/memory-lifecycle/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/memory-ingest \
    && curl -fsSL https://raw.githubusercontent.com/basicmachines-co/basic-memory-skills/refs/heads/main/memory-ingest/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/memory-ingest/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/memory-metadata-search \
    && curl -fsSL https://raw.githubusercontent.com/basicmachines-co/basic-memory-skills/refs/heads/main/memory-metadata-search/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/memory-metadata-search/SKILL.md

RUN mkdir -p ${SHOGGOTH_SKILL_DIR}/caveman \
    && curl -fsSL https://raw.githubusercontent.com/JuliusBrussee/caveman/main/skills/caveman/SKILL.md \
        -o ${SHOGGOTH_SKILL_DIR}/caveman/SKILL.md
