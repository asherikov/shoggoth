ARG BASE_IMAGE=asherikov/ccws:noble
FROM ${BASE_IMAGE}

ARG SHOGGOTH_DOMAIN=

ENV PIP_CACHE_DIR="/cache/ccws/pip"

USER root

RUN git config --system credential.helper 'cache --socket=/shoggoth/git-cred/git_credential_sock' \
    && git config --system user.email 'slave@shoggoth.local' \
    && git config --system user.name 'shoggoth' \
    && printf 'Host *\n  UserKnownHostsFile /shoggoth/git-cred/known_hosts\n' > /etc/ssh/ssh_config.d/shoggoth.conf \
    && mkdir -p /home/ccws/.qwen \
    && printf '{\n  "telemetry": {\n    "enabled": true,\n    "target": "local",\n    "logPrompts": false,\n    "includeSensitiveSpanAttributes": false\n  }\n}\n' > /home/ccws/.qwen/settings.json \
    && chown -R ccws /home/ccws/

RUN \
--mount=type=cache,target=/var/cache/apt,sharing=locked \
--mount=type=cache,target=/var/lib/apt/lists/,sharing=locked \
--mount=type=cache,target=/cache/,sharing=locked \
    curl -fsSL http://download.docker.com/linux/ubuntu/gpg -o /etc/apt/trusted.gpg.d/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture)] http://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
        | sudo tee /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && ${APT_INSTALL} \
        docker-ce-cli \
        docker-buildx-plugin \
        openssh-server \
        ttyd

RUN mkdir -p /home/ccws/.ssh \
    && { printf '# The sandbox runs this daemon unprivileged: as the ccws\n'; \
         printf '# user, on an unprivileged port, with a host key and a pid\n'; \
         printf '# file in the account'\''s own directory. An unprivileged\n'; \
         printf '# sshd cannot read a root-owned host key, cannot write into\n'; \
         printf '# /run and cannot bind a port below 1024.\n'; \
         printf '#\n'; \
         printf '# No Port directive: the port comes from the launcher\n'; \
         printf '# (sandbox.py passes it as ``-o Port=...``), because\n'; \
         printf '# OpenSSH collects Port directives into a list and would\n'; \
         printf '# try to bind the same port twice.\n'; \
         printf '#\n'; \
         printf '# An unprivileged daemon cannot write the system login\n'; \
         printf '# records (utmp/wtmp/lastlog), so sshd logs "Attempt\n'; \
         printf '# to write login records by non-root user (aborting)" on\n'; \
         printf '# every login. That is expected: a sandbox has no\n'; \
         printf '# system login records to keep.\n'; \
         printf '#\n'; \
         printf '# The launcher passes the host key and the pid file on the\n'; \
         printf '# command line too (-o HostKey=..., -o PidFile=...): the\n'; \
         printf '# image and the mounted launcher are versioned separately,\n'; \
         printf '# and a config naming a host key the unprivileged daemon\n'; \
         printf '# cannot read leaves sshd with none at all ("no hostkeys\n'; \
         printf '# available -- exiting"). The values below are the defaults\n'; \
         printf '# the launcher repeats.\n'; \
         printf 'HostKey /home/ccws/.ssh/ssh_host_ed25519_key\n'; \
         printf 'PidFile /home/ccws/.ssh/sshd.pid\n'; \
         printf 'PermitRootLogin no\n'; \
         printf 'PasswordAuthentication yes\n'; \
         printf 'PermitEmptyPasswords no\n'; \
         printf 'KbdInteractiveAuthentication no\n'; \
         printf 'PubkeyAuthentication no\n'; \
         printf 'ChallengeResponseAuthentication no\n'; \
         printf 'AllowUsers ccws\n'; \
         printf 'AllowTcpForwarding no\n'; \
         printf 'UsePAM yes\n'; \
         printf 'ClientAliveInterval 30\n'; \
         printf 'ClientAliveCountMax 6\n'; \
         printf 'LoginGraceTime 30\n'; \
         printf 'MaxAuthTries 3\n'; \
         printf 'MaxSessions 4\n'; \
       } > /etc/ssh/sshd_config \
    && chown -R ccws /home/ccws/.ssh \
    && chmod 0700 /home/ccws/.ssh

# The PAM service for the sandbox's SSH server. The stock Ubuntu
# service runs modules that write to root-owned files (pam_motd
# writes /run/motd.dynamic, pam_lastlog writes /var/log/lastlog,
# pam_loginuid writes /proc/self/loginuid), and an unprivileged
# daemon can only log a warning for each of them on every login.
# This service keeps what works unprivileged: pam_unix for the
# authentication, the account check and the session setup (it
# verifies the password through the setuid-root unix_chkpwd helper,
# so the daemon never reads /etc/shadow itself), and pam_env for
# the locale environment.
RUN { printf '# PAM service for the sandbox SSH server -- see the\n'; \
       printf '# unprivileged-daemon note above.\n'; \
       printf 'auth       required   pam_unix.so\n'; \
       printf 'account    required   pam_unix.so\n'; \
       printf 'session    required   pam_unix.so\n'; \
       printf 'session    optional   pam_env.so\n'; \
       printf 'password   required   pam_unix.so\n'; \
     } > /etc/pam.d/sshd \
    && chmod 0644 /etc/pam.d/sshd

RUN printf 'Acquire::http::Proxy "http://apt-cache";\nAcquire::https::Proxy "false";\n' > /etc/apt/apt.conf.d/00-shoggoth-apt-cache

USER ccws

ARG PYTHON_PKG="mcp opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp-proto-http"
RUN \
--mount=type=cache,target=/cache/pip,sharing=locked \
    (test -z "${SHOGGOTH_DOMAIN}" && pip install ${PYTHON_PKG}) \
    || (test -n "${SHOGGOTH_DOMAIN}" && \
        env PIP_INDEX_URL=http://python-cache.${SHOGGOTH_DOMAIN}/index/ PIP_TRUSTED_HOST=python-cache.${SHOGGOTH_DOMAIN} \
        pip install ${PYTHON_PKG})

ENV SSH_AUTH_SOCK="/shoggoth/git-cred/ssh_auth_sock"
ENV CCWS_CACHE="/cache/ccws/"
ENV PIP_INDEX_URL="http://python-cache/index/"
ENV PIP_TRUSTED_HOST="python-cache"
ENV GITEA_SSH_HOST="git"
ENV OPENAI_BASE_URL="http://litellm/v1/"
ENV OPENAI_MODEL="shoggoth-default"
ENV OPENAI_API_KEY="litellm"
ENV BM_MCP_URL="http://litellm/mcp"
ENV CCACHE_REMOTE_STORAGE="http://build-cache"
ENV CCACHE_REMOTE_ONLY="true"
ENV BUILDCACHE_REMOTE="http://build-cache"
ENV OPENBAO_ADDR="http://openbao:80"
ENV SHOGGOTH_SLAVE_USER="slave"
ENV OTEL_EXPORTER_OTLP_ENDPOINT="http://otelcol:4318"
ENV QWEN_TELEMETRY_OTLP_PROTOCOL="http"
ENV OTEL_SERVICE_NAME="slave"

