                    "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=\"litellm\"}[5m])) by (le, span_name))",
                    "legendFormat": "p95 {{span_name}}",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket{service=\"litellm\"}[5m])) by (le, span_name))",
