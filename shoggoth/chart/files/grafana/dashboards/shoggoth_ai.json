        {
            "title": "Tokens per Request",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 16,
                "y": 18
            },
            "datasource": {
                "uid": "vm"
            },
            "targets": [
                {
                    "expr": "sum by (requested_model) (rate(litellm_input_tokens_metric_total[5m]) + rate(litellm_output_tokens_metric_total[5m])) / sum by (requested_model) (rate(litellm_request_total_latency_metric_count[5m]))",
                    "legendFormat": "{{requested_model}}",
                    "refId": "A"
                },
                {
                    "expr": "sum by (requested_model) (rate(litellm_input_tokens_metric_total[1d]) + rate(litellm_output_tokens_metric_total[1d])) / sum by (requested_model) (rate(litellm_request_total_latency_metric_count[1d]))",
                    "legendFormat": "daily avg {{requested_model}}",
                    "refId": "B"
                }
            ],
            "description": "Average token consumption per request by model (input + output). Daily average uses a 1d rate window.",
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 1.5,
                        "showPoints": "never",
                        "fillOpacity": 10
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": "daily avg.*"
                        },
                        "properties": [
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "dash": [
                                        10,
                                        10
                                    ],
                                    "fill": "dash"
                                }
                            }
                        ]
                    }
                ]
            }
        },
