    "panels": [
        {
            "title": "LLM Request Rate",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "uid": "vm"
            },
            "targets": [
                {
                    "expr": "sum(rate(litellm_request_total_latency_metric_count[5m])) by (requested_model)",
                    "legendFormat": "{{requested_model}}",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(litellm_deployment_failure_responses_total[5m])) by (requested_model)",
                    "legendFormat": "{{requested_model}} errors",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 1.5,
                        "showPoints": "never",
                        "fillOpacity": 10
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*errors"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
