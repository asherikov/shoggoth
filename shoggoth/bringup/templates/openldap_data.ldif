dn: ou=people,${LDAP_BASE_DN}
changetype: add
objectClass: organizationalUnit
ou: people

dn: ou=groups,${LDAP_BASE_DN}
changetype: add
objectClass: organizationalUnit
ou: groups

dn: uid=admin,ou=people,${LDAP_BASE_DN}
changetype: add
objectClass: inetOrgPerson
objectClass: posixAccount
uid: admin
cn: Admin
sn: Admin
uidNumber: 10000
gidNumber: 10000
homeDirectory: /home/admin
mail: admin@${SHOGGOTH_DOMAIN}

dn: uid=sldapauth,ou=people,${LDAP_BASE_DN}
changetype: add
objectClass: inetOrgPerson
objectClass: posixAccount
uid: sldapauth
cn: Service LDAP Auth
sn: LDAP Auth
uidNumber: 10001
gidNumber: 10001
homeDirectory: /home/sldapauth
mail: sldapauth@${SHOGGOTH_DOMAIN}

dn: uid=sslave,ou=people,${LDAP_BASE_DN}
changetype: add
objectClass: inetOrgPerson
objectClass: posixAccount
uid: sslave
cn: Service Slave
sn: CI/CD
uidNumber: 10002
gidNumber: 10002
homeDirectory: /home/sslave
mail: sslave@${SHOGGOTH_DOMAIN}

dn: cn=admins,ou=groups,${LDAP_BASE_DN}
changetype: add
objectClass: groupOfNames
cn: admins
member: uid=admin,ou=people,${LDAP_BASE_DN}

dn: cn=shoggoth-auth,ou=groups,${LDAP_BASE_DN}
changetype: add
objectClass: groupOfNames
cn: shoggoth-auth
member: uid=sldapauth,ou=people,${LDAP_BASE_DN}